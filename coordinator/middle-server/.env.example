# Coordinator Middle Server Environment Configuration

# Server Configuration
SERVER_PORT=4000          # Port for the Coordinator server
SERVER_HOST=localhost     # Hostname for the server

# Authentication
AUTH_SECRET=              # Secret key for authentication
AUTH_TOKEN_EXPIRY=1h      # Authentication token expiration time

# Database Configuration
DB_CONNECTION_STRING=     # Database connection URL
DB_TYPE=postgresql        # Database type
DB_POOL_MAX=10            # Maximum database connection pool size

# External Services
GITHUB_TOKEN=             # GitHub API token
SLACK_WEBHOOK_URL=        # Slack notification webhook

# Logging and Monitoring
LOG_LEVEL=info            # Logging verbosity (debug, info, warn, error)
ENABLE_PROMETHEUS=false   # Enable Prometheus metrics

# Testing Configuration
TEST_MODE=false           # Enable/disable test mode
MOCK_EXTERNAL_SERVICES=false  # Use mock external service endpoints

# Feature Flags
ENABLE_SWARM_JOBS=true    # Enable/disable swarm job processing
MAX_CONCURRENT_JOBS=5     # Maximum number of concurrent jobs

# Security
RATE_LIMIT_WINDOW=15m     # Rate limiting time window
RATE_LIMIT_MAX_REQUESTS=100  # Maximum requests per window