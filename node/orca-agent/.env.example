# Orca Agent Environment Configuration

# Agent Core Configuration
AGENT_MODE=standard       # Agent operational mode (standard, debug, test)
LOG_LEVEL=info            # Logging verbosity (debug, info, warning, error)

# API Settings
API_HOST=localhost        # API server hostname
API_PORT=5000             # API server port
API_KEY=                  # Secret API key for authentication

# Database Configuration
DATABASE_PATH=./data.db   # Path to local database file
DATABASE_TYPE=sqlite      # Database type (sqlite, postgresql)

# External Service Credentials
GITHUB_TOKEN=             # GitHub authentication token
OPENAI_API_KEY=           # OpenAI API key for AI-powered features

# Task Processing
MAX_CONCURRENT_TASKS=3    # Maximum number of concurrent tasks
TASK_TIMEOUT_SECONDS=300  # Maximum task execution time

# Feature Flags
ENABLE_METRICS=false      # Enable performance metrics collection
ENABLE_TRACING=false      # Enable distributed tracing

# Testing Configuration
TEST_MODE=false           # Enable test mode with mock services
MOCK_EXTERNAL_SERVICES=false  # Use mock endpoints during testing

# Security
ALLOWED_ORIGINS=*         # CORS allowed origins
REQUEST_RATE_LIMIT=10     # Requests per minute limit