# Node Environment Configuration

# Server Configuration
PORT=3000                 # Port for the Node server
HOST=localhost            # Hostname for the server

# Database Connection
DATABASE_URL=             # Connection string for the database
DATABASE_TYPE=postgresql  # Type of database (postgresql, mysql, etc.)

# Authentication
JWT_SECRET=               # Secret key for JWT token generation
TOKEN_EXPIRY=1h           # Token expiration time

# External Services
IPFS_GATEWAY=             # IPFS gateway URL
BLOCKCHAIN_RPC_URL=       # Blockchain RPC endpoint

# Logging
LOG_LEVEL=info            # Logging verbosity (debug, info, warn, error)
LOG_FORMAT=json           # Log output format

# Testing
TEST_MODE=false           # Enable/disable test mode
MOCK_SERVICES=false       # Use mock services during testing

# Optional Feature Flags
ENABLE_METRICS=false      # Enable performance metrics
ENABLE_TRACING=false      # Enable distributed tracing